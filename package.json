{
  "name": "aztec-escrow-extensions",
  "version": "4.2.0",
  "repository": "https://github.com/defi-wonderland/aztec-escrow-extensions.git",
  "author": "Wonderland",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./src/artifacts ./target codegenCache.json",
    "codegen": "aztec codegen target --outdir src/artifacts --force",
    "copy-standards-artifacts": "mkdir -p target && cp node_modules/@defi-wonderland/aztec-standards/target/*.json target/ 2>/dev/null || true",
    "compile": "aztec compile && yarn copy-standards-artifacts",
    "postinstall": "yarn copy-standards-artifacts",
    "test": "yarn test:nr && yarn test:js",
    "test:js": "vitest run",
    "test:nr": "aztec test",
    "lint:prettier": "prettier '**/*.{js,ts}' --write",
    "build": "yarn compile && yarn codegen -f",
    "prepare": "husky",
    "ccc": "yarn clean && yarn compile && yarn codegen",
    "bench": "NODE_NO_WARNINGS=1 aztec-benchmark --suffix _base"
  },
  "lint-staged": {
    "*.ts": "prettier --write -u"
  },
  "dependencies": {
    "@aztec/accounts": "4.2.0",
    "@aztec/aztec.js": "4.2.0",
    "@aztec/noir-contracts.js": "4.2.0",
    "@aztec/protocol-contracts": "4.2.0",
    "@aztec/pxe": "4.2.0",
    "@aztec/stdlib": "4.2.0",
    "@aztec/wallets": "4.2.0",
    "@defi-wonderland/aztec-benchmark": "https://github.com/defi-wonderland/aztec-benchmark/releases/download/prerelease-022ee63/defi-wonderland-aztec-benchmark-4.2.0-prerelease.022ee63.tgz",
    "@defi-wonderland/aztec-standards": "https://github.com/defi-wonderland/aztec-standards/releases/download/prerelease-adcef17/defi-wonderland-aztec-standards-4.2.0-prerelease.adcef17.tgz"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.2.0",
    "@types/node": "25.0.10",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.8.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.17"
  },
  "config": {
    "aztecVersion": "4.2.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=1.22.0"
  }
}